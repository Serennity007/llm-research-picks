{
  "name": "llm-research-picks",
  "version": "1.0.0",
  "description": "大模型研究精选 — 语言模型架构、训练、后训练与推理能力研究的人工精选 RSS 与阅读器",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "gen:feeds": "node scripts/build-feeds.mjs",
    "feeds:check": "node scripts/live-check.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check": "npm run gen:feeds && npm test && npm run check:api && npm run build",
    "check:api": "node scripts/check-api.mjs",
    "sources:check": "node scripts/live-check.mjs --sources"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "obsidian": "^1.13.1"
  }
}
